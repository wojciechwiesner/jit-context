%% jit-context architecture as built (master). Rebuilt from src/ imports on 2026-10-29; module import cycles: 0.
%% Package edges come from an AST scan of src/ (tests excluded). Keep in sync when a package is added or split.
graph TD
    subgraph Hosts ["Agent hosts (integrations/ + installer/)"]
        HERMES["Hermes plugin ona-context"]
        CC["Claude Code hooks"]
        OC["OpenCode plugin (TS)"]
        PI["Pi extension (TS)"]
        A0["Agent Zero plugin"]
    end

    subgraph Entry ["Entry points"]
        HOOKS["hooks.py<br/>capsule per turn, tool evidence"]
        CLI["init.py = jit CLI<br/>init, install, skills, doctor"]
        MCP["mcp_server.py<br/>get_jit_context, project state"]
        GIT["git post-commit<br/>l1/post_commit.py"]
    end

    subgraph Compile ["context/ capsule compiler"]
        COMP["compiler.py<br/>compile_context"]
        POLICY["capsule_policy.py<br/>harness filter, host budget, finalize"]
        CASC["cascade_distiller.py<br/>classify, verbatim, assemble"]
        SCAN["project_scan.py + stack_signals.py<br/>stack, dossier name"]
        SKILLS["skill_selector, skill_index, skill_output"]
        GOAL["goal_anchor, domain_router,<br/>compactor, renderer"]
    end

    subgraph L0 ["l0/ hot path (SQLite WAL on the Mac)"]
        OVERLAY["overlay.py + db.py<br/>session overlay, read-your-own-writes"]
        EPI["epistemics.py<br/>authority: user 1.0, assistant 0.0"]
        EVID["tool_evidence + claim_support<br/>verified runtime proofs"]
        FENCE["recent_fence, tool_buffer"]
    end

    subgraph L1 ["l1/ project scope"]
        SCOPE["scope.py<br/>active scope + hysteresis"]
        PCACHE["project_cache.py<br/>dossier + STATE.md"]
        OSYNC["obsidian_sync.py<br/>SSOT header, staleness"]
        CSYNC["cockpit_sync.py<br/>state.html rebuild, diagram drift"]
    end

    subgraph L2 ["l2/ deep path (off by default)"]
        TRIG["triggers.py"]
        L2C["client.py + circuit_breaker.py<br/>600 ms fail-open"]
    end

    subgraph COG ["cognitive/"]
        JEV["jev_engine.py<br/>fact scoring"]
        JUDGE["judge, loop_guard,<br/>contracts, bus"]
    end

    subgraph OPS ["health/ + telemetry/"]
        HEALTH["health/server.py :8765<br/>observatory, mission, livestream"]
        DOCTOR["doctor, autocheck, diagnostics<br/>invariants I1-I10 on a disposable DB"]
        TELE["telemetry/<br/>collector, stream, turn_audit"]
    end

    SMALL["small_context.py + worker/<br/>local 2-9B models"]
    VAULT[("Obsidian vault<br/>projects/name.md")]
    REPO[("project repo .planning/<br/>STATE.md, state.html, ARCHITECTURE.mmd")]
    BROKER["Borg broker / mem-agent"]
    JEVAPI["JEV decisions API"]

